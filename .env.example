# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre projet Supabase
# (Supabase > Project Settings > API). N'utilisez JAMAIS la clé "service_role" ici.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon

# PayDunya secrets are configured in Supabase Edge Function secrets, never here
# and never in VITE_* variables. See the setup instructions for required names.
